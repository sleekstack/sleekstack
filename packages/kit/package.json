    "@sleekstack/next": "workspace:*",
    "@sleekstack/react": "workspace:*",
    "effect": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
