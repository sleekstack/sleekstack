{
  "name": "@sleekstack/kit",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sleekstack/core": "workspace:*",
    "@sleekstack/next": "workspace:*",
    "@sleekstack/react": "workspace:*",
    "effect": "^3.15.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
