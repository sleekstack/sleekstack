{
  "name": "@sleekstack/kit",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./next": { "types": "./src/next/index.ts", "default": "./src/next/index.ts" },
    "./react": { "types": "./src/react/index.ts", "default": "./src/react/index.ts" }
