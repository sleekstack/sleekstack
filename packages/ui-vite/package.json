{
  "name": "@sleekstack/ui-vite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search-client": {
      "types": "./dist/search-client.d.ts",
      "default": "./dist/search-client.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./content-routes": {
      "types": "./dist/content-routes.d.ts",
      "default": "./dist/content-routes.js"
    },
    "./og-meta": {
      "types": "./dist/og-meta.d.ts",
      "default": "./dist/og-meta.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@shikijs/rehype": "^4.5.0",
    "@sleekstack/analyze": "workspace:*",
    "github-slugger": "2.0.0",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.21",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "satori": "0.62.0",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "@sleekstack/ui": "workspace:*",
    "effect": "^3.15.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@sleekstack/router": "workspace:*",
    "@sleekstack/start": "workspace:*",
    "@sleekstack/ui": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^6.0.2",
    "effect": "^3.15.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
