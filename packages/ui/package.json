{
  "name": "@sleekstack/ui",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@tanstack/query-core": "^5.104.1",
    "effect": "^3.15.0"
  },
  "dependencies": {
    "@sleekstack/core": "workspace:*",
    "@sleekstack/query": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.104.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vitest": "^4.1.9",
    "effect": "^3.15.0"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
