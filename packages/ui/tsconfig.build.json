{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmitOnError": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__", "src/**/*.test-d.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
