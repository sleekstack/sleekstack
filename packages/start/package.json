{
  "name": "@sleekstack/start",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sleekstack/runtime": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.15.0",
    "@sleekstack/ui": "workspace:*",
    "@sleekstack/router": "workspace:*"
  },
  "devDependencies": {
    "effect": "^3.15.0",
    "@types/node": "^22.20.1",
    "vitest": "^4.1.9",
    "@sleekstack/ui": "workspace:*",
    "@sleekstack/router": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1"
  }
}
