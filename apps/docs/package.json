{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "check:links": "node scripts/check-links.mjs",
    "predev": "pnpm generate:api",
    "dev": "next dev",
    "prebuild": "pnpm generate:api",
    "build": "next build && pnpm check:links",
    "start": "next start",
    "pretest": "pnpm generate:api",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "12.0.3",
    "fumadocs-ui": "15.8.5",
    "next": "^15.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@sleekstack/core": "workspace:*",
    "@sleekstack/kit": "workspace:*",
    "@sleekstack/next": "workspace:*",
    "@sleekstack/react": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.0",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
