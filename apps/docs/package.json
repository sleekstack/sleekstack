{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "generate:benchmarks": "node scripts/generate-benchmarks.mjs",
    "check:links": "node scripts/check-links.mjs",
    "predev": "pnpm generate:api && pnpm generate:benchmarks",
    "dev": "vite",
    "prebuild": "pnpm generate:api && pnpm generate:benchmarks",
    "build": "vite build && pnpm check:links",
    "preview": "vite preview",
    "pretest": "pnpm generate:api && pnpm generate:benchmarks",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sleekstack/core": "workspace:*",
    "@sleekstack/devtools": "workspace:*",
    "@sleekstack/model": "workspace:*",
    "@sleekstack/query": "workspace:*",
    "@sleekstack/router": "workspace:*",
    "@sleekstack/start": "workspace:*",
    "@sleekstack/testing": "workspace:*",
    "@sleekstack/ui": "workspace:*",
    "@sleekstack/ui-vite": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "effect": "^3.15.0",
    "github-slugger": "2.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
