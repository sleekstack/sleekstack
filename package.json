{
  "name": "sleekstack",
  "version": "0.0.1",
  "private": true,
  "description": "A full-stack Effect-native runtime architecture for React and Next.js.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
